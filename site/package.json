{
  "name": "manager-site",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --mode artifact",
    "dev": "NODE_ENV=development node --watch-path=server --watch-path=server.ts --watch-path=app/shared --import remix/node-tsx server.ts",
    "start": "NODE_ENV=production node --import remix/node-tsx server.ts",
    "sync": "node --import remix/node-tsx sync.ts",
    "test": "npm run build && remix test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "marked": "18.1.1",
    "remix": "3.1.0",
    "tree-sitter-go": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "web-tree-sitter": "0.25.10"
  },
  "devDependencies": {
    "@types/dom-navigation": "1.0.7",
    "@types/node": "24.10.1",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "7.3.3"
  }
}
