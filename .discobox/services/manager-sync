#!/bin/sh
#---
# id: manager-sync
# name: Manager artifact sync
# description: Keeps the Manager status artifact's documents current and ingests its button presses
#---
# Runs site/sync.ts: builds JSON documents from the status table and GitHub (reads only) into
# ~/.local/state/discobox-manager/artifact-sync, queues write_db batches in its outbox for the
# sync agent, and appends actions pulled from the artifact to actions.jsonl. Serves no port.
root="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd)"
[ -x "$root/site/sync.sh" ] || root="$PWD"
exec "$root/site/sync.sh"
