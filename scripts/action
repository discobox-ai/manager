#!/usr/bin/env python3
"""The owner's recorded actions, from the manager site (site/), for the manager to carry out.

  action list [--all] [--json]   pending actions, one per line (--all: done ones too)
  action done ID [NOTE ...]      mark an action done, with an optional note the owner sees
  action unresolve ID NOTE ...   reopen the owner's "Resolved" (a resolve action): the row goes back
                                 to Your move on the page, with NOTE saying why it still needs them

The site appends each action to actions.jsonl; done marks go to actions-done.jsonl, one JSON
line each, in SITE_STATE_DIR (default ~/.local/state/discobox-manager).
"""
import datetime, json, os, sys

DIR = os.path.expanduser(os.environ.get("SITE_STATE_DIR", "~/.local/state/discobox-manager"))
ACTIONS = os.path.join(DIR, "actions.jsonl")
DONE = os.path.join(DIR, "actions-done.jsonl")


def read(path):
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if not line:
                    continue
                try:
                    out.append(json.loads(line))
                except ValueError:
                    pass
    except FileNotFoundError:
        pass
    return out


def done_ids():
    return {d.get("id"): d for d in read(DONE) if d.get("done")}


def target(a):
    repo = (a.get("repo") or "").replace("discobox-ai/", "")
    ref = lambda n: f"{repo}#{n}" if repo else f"#{n}"
    k = a.get("kind")
    if k == "close-pr":
        return f"close PR {ref(a.get('pr'))}" + (f" reason={a['reason']!r}" if a.get("reason") else "")
    if k == "close-issue":
        return f"close issue {ref(a.get('issue'))} as {a.get('stateReason')}" + (f" reason={a['reason']!r}" if a.get("reason") else "")
    if k == "prioritize":
        return f"label issue {ref(a.get('issue'))} {a.get('priority')}"
    if k == "instruct":
        return f"instruction: {a.get('text')!r}"
    if k == "resolve":
        return f"resolved, says the owner: move={a.get('move')!r}"
    return k or "?"


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, args = argv[1], argv[2:]
    if cmd == "list":
        done = done_ids()
        for a in read(ACTIONS):
            d = done.get(a.get("id"))
            if d and "--all" not in args:
                continue
            if "--json" in args:
                print(json.dumps({**a, **({"done": True, "note": d.get("note")} if d else {})}))
                continue
            status = ("reopened" if d.get("unresolved") else "done   ") if d else "pending"
            print(f"{a.get('id')}  {status}  {a.get('at', '')[:16]}  [{a.get('key')}]  {target(a)}"
                  + (f"  -- {d.get('note')}" if d and d.get("note") else ""))
    elif cmd in ("done", "unresolve"):
        if not args:
            sys.exit(f"action: {cmd} needs an ID")
        aid, note = args[0], " ".join(args[1:])
        action = next((a for a in read(ACTIONS) if a.get("id") == aid), None)
        if not action:
            sys.exit(f"action: no action {aid!r}")
        if cmd == "unresolve" and action.get("kind") != "resolve":
            sys.exit(f"action: {aid} is a {action.get('kind')}, not a resolve")
        if cmd == "unresolve" and not note:
            sys.exit("action: unresolve needs a NOTE: why the row still needs the owner")
        line = {"id": aid, "done": True, "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")}
        if cmd == "unresolve":
            line["unresolved"] = True
        if note:
            line["note"] = note
        os.makedirs(DIR, exist_ok=True)
        fd = os.open(DONE, os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o644)
        try:
            os.write(fd, (json.dumps(line) + "\n").encode())
        finally:
            os.close(fd)
    else:
        sys.exit(f"action: unknown command {cmd!r}")


if __name__ == "__main__":
    main(sys.argv)
