#!/usr/bin/env bash
# Start one worker box for a job, the way the `workers` skill's Launch section says.
#
#   scripts/launch SKILL --repo OWNER/NAME [--issue N] [--job JOB] [-p PROMPT]
#                  [--role ROLE] [--base BRANCH] [--harness H] [--no-source] [-i SOURCE]...
#                  [--pool POOL] [--no-label] [--dry-run]
#
# Where it runs (owner, 2026-11-23): the local default pool while the host has
# room (1-minute load at or below disk.maxLoad, free disk at or above
# disk.minFreeGiB); past either, workers.overflowPool (the archil pool), and
# with no overflow pool it launches nothing. Only worker jobs overflow
# (owner, 2026-11-23: "ensure that all long running boxes, like norm, prcoess
# checks, live runs, run on local also. Only want "worker" boxes to go to
# archil"): deliver-issue, triage-issue, propose-adr, fix-ci, rebase-pr,
# prototype. Every other skill, an issue whose Done when is verified
# **live**, and --local stay here, and on a busy host wait as before.
# --pool POOL picks the pool outright; --ignore-load keeps a box on the local
# pool whatever the load.
#
# The harness is workers.harness, except for bug fixes: deliver-issue on an issue
# labelled type/bug or type/flake, and fix-ci, run workers.bugHarness (owner,
# 2026-11-10). A repository's own harness in manager.yaml (repos[].harness)
# overrides both, and --harness overrides everything.
#
# -i SOURCE brings an extra source into the box (repeat it), as `discobox run -i`
# does: OWNER/REPO[@REF]. Only public repositories: from inside a box the CLI
# lends no Git credentials, so a private one never arrives.
#
# The box starts from, and its PR targets, the repository's default branch, or
# the branch of the feature track whose epic lists the issue (manager.yaml
# tracks), or --base.
#
# SKILL is a directory in worker-skills/ (deliver-issue, triage-issue, propose-adr, fix-ci,
# rebase-pr, validate-release, ...). It reads, from manager.yaml, the harness
# (workers.harness), the fork owner and the repository's default
# branch; from the skill, the role it runs under; from `discobox-access`, the one
# delegated GitHub secret. It then runs the box, tags it, moves the issue to
# status/in-progress (deliver and ADR jobs). A box trusts its folder by itself
# (Codex: discobox#571, PR 707): nothing here answers a dialog.
#
# It refuses to launch when this checkout is dirty or not pushed (the box installs
# its skills from the pushed main), or when workers.paused is true.
set -euo pipefail

cd "$(dirname "$0")/.."

die() { echo "launch: $*" >&2; exit 1; }

SKILL="" REPO="" ISSUE="" JOB="" PROMPT="" ROLE="" NOSRC="" NOLABEL="" IGNORELOAD="" IGNOREPAUSE="" DRY="" POOLARG="" LOCAL="" BASEARG="" HARNESSARG="" INCLUDES=() EXTRABINDS=()
[ $# -gt 0 ] || die "usage: scripts/launch SKILL --repo OWNER/NAME [--issue N] [--job JOB] [-p PROMPT] [--role ROLE] [--base BRANCH] [--bind SECRET:VAR@HOSTS]... [--no-source] [--no-label] [--dry-run]"
SKILL=$1; shift
while [ $# -gt 0 ]; do
  case $1 in
    --repo) REPO=$2; shift 2 ;;
    --issue) ISSUE=$2; shift 2 ;;
    --job) JOB=$2; shift 2 ;;
    -p|--prompt) PROMPT=$2; shift 2 ;;
    --role) ROLE=$2; shift 2 ;;
    --base) BASEARG=$2; shift 2 ;;
    --harness) HARNESSARG=$2; shift 2 ;;
    -i|--include) INCLUDES+=("$2"); shift 2 ;;
    --bind) EXTRABINDS+=("$2"); shift 2 ;;
    --no-source) NOSRC=1; shift ;;
    --no-label) NOLABEL=1; shift ;;
    --pool) POOLARG=$2; shift 2 ;;
    --local) LOCAL=1; shift ;;
    --ignore-load) IGNORELOAD=1; shift ;;
    --ignore-pause) IGNOREPAUSE=1; shift ;;
    --dry-run) DRY=1; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done

[ -f "worker-skills/$SKILL/SKILL.md" ] || die "no worker skill worker-skills/$SKILL"
[ -n "$REPO" ] || die "--repo is required"

# --- manager.yaml -----------------------------------------------------------
HARNESS=$(sed -n 's/^  harness: *//p' manager.yaml | head -1)
FORK=$(sed -n 's/^  forkOwner: *//p' manager.yaml | head -1)
PAUSED=$(sed -n 's/^  paused: *//p' manager.yaml | head -1)
BRANCH=$(awk -v r="$REPO" '$1=="-" && $2=="name:" {cur=$3} /defaultBranch:/ && cur==r {print $2; exit}' manager.yaml)
[ -n "$HARNESS" ] || die "manager.yaml has no workers.harness"
[ -n "$FORK" ] || die "manager.yaml has no github.forkOwner"
[ -n "$BRANCH" ] || die "$REPO is not in manager.yaml's repos"
# A feature track whose epic's checklist lists this issue gives the base.
TRACK=""
if [ -z "$BASEARG" ] && [ -n "$ISSUE" ]; then
  while read -r t_repo t_branch t_epic; do
    [ "$t_repo" = "$REPO" ] || continue
    if gh api "repos/$REPO/issues/$t_epic" --jq .body 2>/dev/null | grep -Eq "#$ISSUE([^0-9]|\$)"; then
      BASEARG=$t_branch TRACK=$t_epic; break
    fi
  done < <(awk '/^tracks:/ {t=1; next} t && /^[^ #]/ {t=0} t && $1=="repo:" {r=$2} t && $1=="branch:" {b=$2} t && $1=="epic:" {print r, b, $2}' manager.yaml)
fi
[ -z "$BASEARG" ] || BRANCH=$BASEARG
# Bug fixes run workers.bugHarness (owner, 2026-11-10).
BUGHARNESS=$(sed -n 's/^  bugHarness: *//p' manager.yaml | head -1)
KIND=""
if [ -n "$BUGHARNESS" ]; then
  case $SKILL in
    fix-ci) KIND=bug ;;
    deliver-issue)
      if [ -n "$ISSUE" ] && gh api "repos/$REPO/issues/$ISSUE" --jq '.labels[].name' 2>/dev/null | grep -qxE 'type/(bug|flake)'; then
        KIND=bug
      fi ;;
  esac
  [ "$KIND" != bug ] || HARNESS=$BUGHARNESS
fi
# A repository's own harness (repos[].harness) wins over both (owner, 2026-11-11:
# discobox-ai/review runs codex for all its work).
REPOHARNESS=$(awk -v r="$REPO" '$1=="-" && $2=="name:" {cur=$3; next} cur==r && $1=="harness:" {print $2; exit} /^[^ #]/ {cur=""}' manager.yaml)
if [ -n "$REPOHARNESS" ]; then HARNESS=$REPOHARNESS; KIND=""; fi
[ -z "$HARNESSARG" ] || HARNESS=$HARNESSARG
STOPPED=$(sed -n 's/^  stopped: *\([a-z]*\).*/\1/p' manager.yaml | head -1)
if [ "$STOPPED" = true ]; then die "workers.stopped is true in manager.yaml: the factory is stopped (/stop); only /resume starts boxes again"; fi
# Pool: local while the host has room, else the overflow pool (owner,
# 2026-11-23: "if the local load average is higher than 100 ... we launch new
# boxes on archil. We prefer local default pool as long as there is enough disk
# space and load is low enough"). Before that, a busy host launched nothing
# (owner, 2026-11-20). --ignore-load is for a box the owner asked for by name
# on this host; --pool picks the pool outright.
MAXLOAD=$(sed -n 's/^  maxLoad: *//p' manager.yaml | head -1); MAXLOAD=${MAXLOAD:-100}
MINFREE=$(sed -n 's/^  minFreeGiB: *//p' manager.yaml | head -1); MINFREE=${MINFREE:-60}
OVERFLOW=$(sed -n 's/^  overflowPool: *//p' manager.yaml | head -1)
LOAD1=$(cut -d' ' -f1 /proc/loadavg)
FREE=$(df -BG --output=avail / | tail -1 | tr -dc 0-9)
POOL=$POOLARG WHY=""
if [ -z "$POOL" ] && [ -z "$IGNORELOAD" ]; then
  if [ "${LOAD1%.*}" -gt "$MAXLOAD" ]; then WHY="load average $LOAD1 is above $MAXLOAD (disk.maxLoad)"
  elif [ "$FREE" -lt "$MINFREE" ]; then WHY="free disk ${FREE}G is under ${MINFREE}G (disk.minFreeGiB)"; fi
  # Long-lived and live-run boxes never overflow: only worker jobs do.
  case $SKILL in deliver-issue|triage-issue|propose-adr|fix-ci|rebase-pr|prototype) ;; *) LOCAL=1 ;; esac
  if [ -z "$LOCAL" ] && [ -n "$ISSUE" ] && gh api "repos/$REPO/issues/$ISSUE" --jq .body 2>/dev/null | grep -q '\*\*live\*\*'; then LOCAL=1; fi
  if [ -n "$WHY" ]; then
    [ -z "$LOCAL" ] || die "$WHY, and a $SKILL box${ISSUE:+ for a live run or #$ISSUE} stays on this host: no launch until it recovers (or --ignore-load)"
    [ -n "$OVERFLOW" ] || die "$WHY, and workers.overflowPool is unset: no new boxes until it recovers"
    POOL=$OVERFLOW
    echo "launch: $WHY: launching on the $POOL pool" >&2
  fi
fi
if [ "$PAUSED" = true ]; then
  EXC=$(sed -n 's/^  pausedExcept: *\[\(.*\)\]/\1/p' manager.yaml | head -1 | tr -d ' ')
  case ",$EXC," in *",${ISSUE:-none},"*) ;; *) [ -n "$IGNOREPAUSE" ] || die "workers.paused is true in manager.yaml: no new boxes except issues in pausedExcept ($EXC)" ;; esac
fi
OWNER=${REPO%%/*} NAME=${REPO#*/}

# --- job, role, prompt ------------------------------------------------------
if [ -z "$JOB" ]; then
  case $SKILL in
    deliver-issue) JOB=deliver ;;
    triage-issue) JOB=triage ;;
    propose-adr) JOB=adr ;;
    fix-ci) JOB=fix-ci ;;
    rebase-pr) JOB=rebase ;;
    validate-release) JOB=validate ;;
    migrate-labels) JOB=labels ;;
    cut-release) JOB=tag ;;
    merge-track) JOB=merge ;;
    *) JOB=$SKILL ;;
  esac
fi
if [ -z "$ROLE" ]; then
  ROLE=$(sed -n '/^---$/,/^---$/p' "worker-skills/$SKILL/SKILL.md" | sed -n 's/^ *discobox\.role: *//p' | head -1)
fi
[ -n "$ROLE" ] || die "worker-skills/$SKILL names no discobox.role; pass --role"
# Role `none` (cut-release): the box is bound nothing and asks the owner itself.
[ "$ROLE" = none ] || [ -f "roles/$ROLE.json" ] || die "no roles/$ROLE.json"
if [ -z "$PROMPT" ]; then
  [ -n "$ISSUE" ] || die "give -p PROMPT, or --issue N for the default prompt"
  case $SKILL in
    deliver-issue) PROMPT="Deliver issue #$ISSUE in $REPO." ;;
    triage-issue) PROMPT="Triage issue #$ISSUE in $REPO." ;;
    propose-adr) PROMPT="Propose an ADR for issue #$ISSUE in $REPO." ;;
    *) die "no default prompt for $SKILL: give -p PROMPT" ;;
  esac
fi
# The proxy judge clips a prompt at 256 bytes and reads the cut as hidden instructions.
[ "$(printf %s "$PROMPT" | wc -c)" -le 256 ] || die "prompt is over 256 bytes; put the detail in the issue"

# A role that pushes takes the fork; triage and label roles don't.
PUSHES=1
case $ROLE in github-triage|github-labels|github-manager|none) PUSHES="" ;; esac

# --- credentials ------------------------------------------------------------
# The box's own DISCOBOX_* environment already reaches the right server; leave it alone.
eval "$(discobox-access env)"
GH_SECRET=$(discobox-access list -json | jq -r '[.credentials[] | select(.purpose == "delegate" and (.hosts | index("api.github.com"))) | .name] | if length == 1 then .[0] else "" end')
[ -n "$GH_SECRET" ] || die "no single delegated GitHub credential (discobox-access list): launch nothing and tell the owner"

# `discobox run` reads the repository and --skills with this box's git, which has no login.
HELPER='!f() { echo username=x-access-token; echo "password=$GH_TOKEN"; }; f'
export GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=credential.helper GIT_CONFIG_VALUE_0= \
  GIT_CONFIG_KEY_1=credential.helper GIT_CONFIG_VALUE_1="$HELPER"

# --- this checkout must be pushed -------------------------------------------
[ -z "$(git status --porcelain)" ] || die "this checkout has uncommitted changes: commit and push first (workers install skills from the pushed main)"
git fetch -q origin main
[ "$(git rev-parse HEAD)" = "$(git rev-parse origin/main)" ] || die "HEAD is not origin/main: push (or pull) first"

BIND="$GH_SECRET:GH_TOKEN,policy=roles/$ROLE.json,owner=$OWNER,repo=$NAME${PUSHES:+,forkOwner=$FORK}"
SRC="https://github.com/$REPO@$BRANCH"
# Skills go in as a local directory, copied from this checkout (equal to the pushed
# main, checked above). Given as discobox-ai/manager//worker-skills, the pool fetches
# the private repository itself, and from inside a box the CLI never lends it Git
# credentials: the box waits for its source forever (2026-11-05).
ARGS=(run -d -H "$HARNESS" --skills "$PWD/worker-skills")
[ -z "$POOL" ] || ARGS+=(--pool "$POOL")
[ "$ROLE" = none ] || ARGS+=(--bind "$BIND")
# Provider credentials (manager.yaml providers), always narrowed to their hosts.
for b in "${EXTRABINDS[@]}"; do
  case $b in *@*|*,policy=*) ARGS+=(--bind "$b") ;; *) die "--bind takes SECRET:VAR@HOST[,HOST] or SECRET:VAR,policy=roles/<file>.json: name the hosts or the routes" ;; esac
done
if [ -n "$NOSRC" ]; then ARGS+=(--no-source); else ARGS+=("$SRC"); fi
for inc in "${INCLUDES[@]}"; do
  case $inc in */*) ARGS+=(-i "https://github.com/${inc}") ;; *) die "-i takes OWNER/REPO[@REF]" ;; esac
done
ARGS+=(-p "$PROMPT")

if [ -n "$DRY" ]; then
  echo "pool=${POOL:-default}${WHY:+ ($WHY)} harness=$HARNESS${KIND:+ (bug fix)} job=$JOB role=$ROLE fork=${PUSHES:+$FORK} base=$BRANCH${TRACK:+ track=#$TRACK}"
  echo "discobox ${ARGS[*]}"
  exit 0
fi

# --- launch -----------------------------------------------------------------
OUT=$(discobox "${ARGS[@]}" 2>&1) || true
echo "$OUT" | tail -3
ID=$(echo "$OUT" | grep -o 'sbx_[a-z0-9]*' | head -1)
[ -n "$ID" ] || die "no box ID in the output. A launch that errors can still make a box: look in 'discobox ls' before launching again"

# --- tag, label -------------------------------------------------------------
TAGS=(repo="$REPO" job="$JOB")
[ -z "$ISSUE" ] || TAGS+=(issue="$ISSUE")
[ -z "$PUSHES" ] || TAGS+=(fork="$FORK")
TAGS+=(base="$BRANCH")
[ -z "$POOL" ] || TAGS+=(pool="$POOL")
DESC=""
if [ -n "$ISSUE" ]; then
  TITLE=$(gh api "repos/$REPO/issues/$ISSUE" --jq .title 2>/dev/null || true)
  DESC="${NAME}#${ISSUE}: ${TITLE}"
fi
discobox tag "$ID" "${TAGS[@]}" ${DESC:+--description "$DESC"} >/dev/null

if [ -n "$ISSUE" ] && [ -z "$NOLABEL" ]; then
  case $JOB in deliver|adr)
    gh api -X DELETE "repos/$REPO/issues/$ISSUE/labels/status%2Fready" --silent 2>/dev/null || true
    gh api -X POST "repos/$REPO/issues/$ISSUE/labels" -f 'labels[]=status/in-progress' --silent
    # in-progress always names its box (owner, 2026-11-16): the label is set
    # only here, after the box exists, and the issue says which box it is.
    gh api -X POST "repos/$REPO/issues/$ISSUE/comments" --silent \
      -f body="**In progress:** a \`$JOB\` worker is on this issue in discobox:///$ID (launched by the manager)."
    ;;
  esac
fi

# The table's "running" header counts workers from `discobox ls`; refresh it now.
scripts/table slots >/dev/null 2>&1 || true

echo "$ID"
