#!/usr/bin/env bash
# Keep status/in-review true on every open PR in the watched repositories
# (github skill, Filing and editing; docs/labels.md). A PR has the label when it
# is out of draft, its head's checks are all green (the commit's check rollup is
# SUCCESS), it has no merge conflict, and it has the pr-check box's (or the
# manager's) "**Process check** at `<head sha>`" comment for that head. An ADR
# PR (every file under an adr/ directory) needs no Process check (owner,
# 2026-11-18: "I want to be able to just look for the in-review label so know I
# should look"). Any other open PR doesn't have it.
#
# Label changes re-run CI (the workflows trigger on labeled/unlabeled), so this
# never changes a PR whose checks are pending or whose mergeability GitHub is
# still computing: only a draft, a failed check, a conflict, or a head without
# a Process check takes the label off.
#
# Cost: ONE GraphQL query per repository per pass, no REST calls except the
# label changes themselves. The bot's REST allowance is shared by every worker
# (2026-11-18: the per-PR REST version used up 5000/h).
#   scripts/pr-review-labels           # list what would change
#   scripts/pr-review-labels --apply   # change the labels
set -euo pipefail
cd "$(dirname "$0")/.."
eval "$(discobox-access env)"
apply=0; [ "${1:-}" = --apply ] && apply=1

Q='query($owner:String!,$name:String!){repository(owner:$owner,name:$name){
  defaultBranchRef{target{... on Commit{statusCheckRollup{state}}}}
  pullRequests(states:OPEN,first:100){nodes{
  number isDraft headRefOid mergeable changedFiles
  labels(first:30){nodes{name}}
  files(first:30){nodes{path}}
  comments(last:30){nodes{body author{login}}}
  commits(last:1){nodes{commit{statusCheckRollup{state}}}}
}}}}'

for repo in $(awk '/^  - name: /{print $3}' manager.yaml); do
  out=$(gh api graphql -f query="$Q" -F owner="${repo%%/*}" -F name="${repo#*/}" --jq '
    # A repository whose default branch has no checks at all (release-validation)
    # has no CI: its PRs count as green.
    (.data.repository.defaultBranchRef.target.statusCheckRollup == null) as $noci |
    .data.repository.pullRequests.nodes[] |
    (.headRefOid[0:7]) as $short |
    (.commits.nodes[0].commit.statusCheckRollup.state // (if $noci then "SUCCESS" else "NONE" end)) as $ci |
    (any(.labels.nodes[]; .name == "status/in-review")) as $has |
    ((.changedFiles > 0) and (.changedFiles <= 30) and all(.files.nodes[]; .path | test("(^|/)adr/"))) as $adr |
    # A community PR has no Process check: the "merge it" recommendation of
    # its community-review box at the head stands in for one (owner,
    # 2026-11-25). Only comments by the bot count: anyone can type a
    # "Process check" into a community PR.
    (any(.comments.nodes[]; (.author.login // "") == "ibuildthecloud-bot" and (.body | startswith("**Process check** at `" + $short) or (startswith("**Community review: recommendation** at `" + $short) and test("\\*\\*Merge it\\*\\*"))))) as $checked |
    (if .isDraft then "false"
     elif $ci == "PENDING" or $ci == "EXPECTED" or .mergeable == "UNKNOWN" then "skip"
     elif $ci != "SUCCESS" then "false"
     elif $adr then "true"   # an ADR PR is in review even with a conflict: it is not rebased until approved (owner, 2026-11-20)
     elif .mergeable == "CONFLICTING" then "false"
     elif $checked then "true"
     else "false" end) as $want |
    [.number, $want, $has] | @tsv' 2>&1) || { echo "$repo: query failed: ${out:0:200}" >&2; continue; }
  while IFS=$'\t' read -r n want has; do
    [ -n "$n" ] || continue
    if [ "$want" = true ] && [ "$has" = false ]; then
      echo "$repo#$n + status/in-review"
      if [ $apply = 1 ]; then gh api -X POST "repos/$repo/issues/$n/labels" -f 'labels[]=status/in-review' --silent; fi
    elif [ "$want" = false ] && [ "$has" = true ]; then
      echo "$repo#$n - status/in-review"
      if [ $apply = 1 ]; then gh api -X DELETE "repos/$repo/issues/$n/labels/status%2Fin-review" --silent; fi
    fi
  done <<<"$out"
done
