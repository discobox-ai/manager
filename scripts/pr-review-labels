#!/usr/bin/env bash
# Keep status/in-review true on every open PR in the watched repositories.
# Label changes re-run CI (the workflows trigger on labeled/unlabeled), so this
# never removes the label because checks are merely pending: only a draft, a
# failed check, or a head without a Process check takes it off, and it adds
# the label only once every check has completed green. Changes are rare by
# design.
# (github skill, Filing and editing; docs/labels.md): a PR that is out of
# draft, with every check on its head completed green (success, skipped,
# neutral), no merge conflict, and the pr-check box's (or the manager's)
# "**Process check** at `<head sha>`" comment for that head, has the label;
# any other open PR doesn't. An ADR PR (every file it changes is under an
# adr/ directory) needs no Process check: green and no conflict is enough
# (owner, 2026-11-18: "I want to be able to just look for the in-review
# label so know I should look"). Prints each change.
#   scripts/pr-review-labels           # list what would change
#   scripts/pr-review-labels --apply   # change the labels
set -euo pipefail
cd "$(dirname "$0")/.."
eval "$(discobox-access env)"
apply=0; [ "${1:-}" = --apply ] && apply=1
for repo in $(awk '/^  - name: /{print $3}' manager.yaml); do
  gh api "repos/$repo/pulls?state=open&per_page=100" \
    --jq '.[] | [.number, .draft, .head.sha, (any(.labels[]; .name == "status/in-review"))] | @tsv' 2>/dev/null |
  while IFS=$'\t' read -r n draft sha has; do
    want=false
    if [ "$draft" = false ]; then
      runs=$(gh api "repos/$repo/commits/$sha/check-runs?per_page=100" \
        --jq '([.check_runs[] | select(.status == "completed" and (.conclusion | IN("success","skipped","neutral") | not))] | length), ([.check_runs[] | select(.status != "completed")] | length), (.check_runs | length)' | paste -sd' ')
      read -r failed pending total <<<"$runs"
      if [ "$pending" -gt 0 ] && [ "$failed" -eq 0 ]; then
        continue   # a run in progress (often a label's own re-run): leave the label as it is
      fi
      if [ "$total" -gt 0 ] && [ "$failed" -eq 0 ]; then
        mstate=$(gh api "repos/$repo/pulls/$n" --jq '.mergeable_state')
        if [ "$mstate" = unknown ]; then continue; fi   # GitHub still computing: leave it
        if [ "$mstate" != dirty ]; then
          adr=$(gh api "repos/$repo/pulls/$n/files?per_page=100" \
            --jq '(length > 0) and all(.[]; .filename | test("(^|/)adr/"))')
          short=${sha:0:7}
          if [ "$adr" = true ]; then
            want=true
          elif gh api "repos/$repo/issues/$n/comments?per_page=100" \
               --jq '.[].body' | grep -q "Process check\*\* at \`$short"; then
            want=true
          fi
        fi
      fi
    fi
    if [ "$want" = true ] && [ "$has" = false ]; then
      echo "$repo#$n + status/in-review"
      if [ $apply = 1 ]; then gh api -X POST "repos/$repo/issues/$n/labels" -f 'labels[]=status/in-review' --silent; fi
    elif [ "$want" = false ] && [ "$has" = true ]; then
      echo "$repo#$n - status/in-review"
      if [ $apply = 1 ]; then gh api -X DELETE "repos/$repo/issues/$n/labels/status%2Fin-review" --silent; fi
    fi
  done
done
