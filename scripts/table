#!/usr/bin/env python3
"""Edit the manager's status table, the file the manager-table mod draws.

Rows are keyed: an issue ("460", "vm 33"), or a PR ("pr 411", "pr vm 31")
for a row with no issue, or a name for anything else ("finished").

  table set KEY field=value ...    update a row (adds it, at the end, if missing)
  table add KEY [--at N|--before KEY] field=value ...
  table rm KEY ...                 remove rows
  table move KEY --at N|--before KEY
  table link LABEL URL             add or replace a link under the table
  table unlink LABEL ...
  table show                       the rows, one per line
  table slots                      refresh the slot list (running workers) from discobox ls
  table rank [KEY ...]             re-read each row's labels and milestone from GitHub
                                   (all rows, or the KEYs) and re-sort the table
  table sync                       reconcile rows with GitHub: clear a "Your move" whose
                                   PRs have all merged or closed, and drop rows whose issue
                                   is closed with no open PR named; prints what changed

Fields: item agent issue pr doing move why blocker stream ("move" is "Your move"; "–" is
none; blocker=yes puts a row in group 1 when no label says so, e.g. broken CI).
Every write is atomic (a temp file, then a rename) and stamps postedAt.

Ranking (docs/labels.md, Next up). Every write sorts the rows by group, then
priority, keeping the current order among equals, so the order can't drift:
  1 Blocker      type/flake, or blocker=yes
  2 <release>    in a milestone named release.milestone, in any managed
                 repository (same-named milestones), or listed in release.alsoIn
  3 <next>       in a milestone named release.next, in any managed repository
  4 Other        everything else that is open
  5 Done         closed issues and merged or closed PRs
Priority within a group: critical, high, medium, low, none. `rank` stores each
row's group and priority (fields `group`, `prio`) and rewrites `why` as
"<group> <name> (<priority>)"; a new row with an issue or PR key is ranked
when it's added.
"""
import json
import re, os, sys, time

PATH = os.path.expanduser(os.environ.get("MANAGER_TABLE", "~/.local/state/discobox-manager/table.json"))
FIELDS = {"item": "item", "agent": "agent", "issue": "issue", "pr": "pr", "doing": "doing", "move": "yourMove", "yourMove": "yourMove", "why": "why", "blocker": "blocker", "stream": "stream"}
ROOT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
PRIOS = ["critical", "high", "medium", "low"]


def load():
    try:
        with open(PATH) as f:
            d = json.load(f)
    except FileNotFoundError:
        d = {}
    d.setdefault("rows", [])
    d.setdefault("links", [])
    for r in d["rows"]:
        # A bare PR number takes its issue's repository ("vm 49" → PR "vm 52").
        iss, pr = str(r.get("issue", "-")), str(r.get("pr", "-"))
        m = re.match(r"^([a-z][\w.-]*) \d+$", iss)
        if m and re.match(r"^\d+$", pr):
            r["pr"] = f"{m.group(1)} {pr}"
        k = r.get("key", "")
        if r.get("issue", "-") in ("-", "") and ISSUE_KEY.match(k) and not k.startswith("pr "):
            r["issue"] = k
    return d


def save(d):
    d["postedAt"] = int(time.time() * 1000)
    os.makedirs(os.path.dirname(PATH), exist_ok=True)
    tmp = PATH + ".tmp"
    with open(tmp, "w") as f:
        json.dump(d, f, indent=1)
    os.replace(tmp, PATH)


def key_of(r):
    if r.get("key"):
        return r["key"]
    if r.get("issue") not in (None, "", "-"):
        return r["issue"]
    if r.get("pr") not in (None, "", "-"):
        return "pr " + r["pr"]
    return r.get("item", "")


def find(rows, key):
    for i, r in enumerate(rows):
        if key_of(r) == key:
            return i
    return -1


def parse(args):
    out, pos = {}, {}
    i = 0
    while i < len(args):
        a = args[i]
        if a in ("--at", "--before"):
            pos[a] = args[i + 1]
            i += 2
            continue
        k, sep, v = a.partition("=")
        if not sep or k not in FIELDS:
            sys.exit(f"table: bad field {a!r} (fields: {', '.join(sorted(set(FIELDS) - {'yourMove'}))})")
        if FIELDS[k] in ("issue", "pr"):
            v = norm_ref(v)
        out[FIELDS[k]] = v
        i += 1
    return out, pos


def norm_ref(v):
    """An issue or PR field in one form the renderers read: "677" for discobox,
    "<repo> <N>" for any other repository. Accepts "#677", "discobox#677",
    "discobox-ai/vm#46", "vm#46", "vm 46"; anything else is kept as given."""
    t = v.strip()
    m = re.match(r"^(?:discobox-ai/)?([A-Za-z][\w.-]*?)?\s*#?\s*(\d+)$", t)
    if not m:
        return v
    repo, num = m.group(1), m.group(2)
    if not repo or repo == "discobox":
        return num
    return f"{repo} {num}"


def place(rows, row, pos):
    if "--at" in pos:
        rows.insert(max(0, int(pos["--at"]) - 1), row)
    elif "--before" in pos and find(rows, pos["--before"]) >= 0:
        rows.insert(find(rows, pos["--before"]), row)
    else:
        rows.append(row)


def blank(key):
    r = {f: "-" for f in ("item", "agent", "issue", "pr", "doing", "why")}
    r["yourMove"] = "–"
    r["key"] = key
    if ISSUE_KEY.match(key):
        r["issue"] = key
    return r


# An issue key: "460", or "vm 33" for another repository ("manager 1" too).
ISSUE_KEY = re.compile(r"^(?:[a-z][\w.-]* )?\d+$")


def slots():
    """Running workers this box created, for the header: {max, boxes: [{id, label}]}."""
    import subprocess
    out = subprocess.run(["discobox", "ls", "-o", "json"], capture_output=True, text=True, check=True).stdout
    me = json.load(open(os.path.expanduser("~/.discobox/meta.json"))).get("id") if os.path.exists(os.path.expanduser("~/.discobox/meta.json")) else None
    boxes = []
    for b in json.loads(out).get("sandboxes", []):
        tags = (b.get("meta") or {}).get("tags") or {}
        state = (b.get("runtime") or {}).get("runtimeState")
        if not tags.get("job") or state not in ("running", "starting"):
            continue
        if tags["job"] in ("merge-gate", "merge-queue", "pr-check", "norm"):
            continue  # long-lived service boxes never count against workers.max
        if me and b.get("createdBySandboxId") not in (None, me):
            continue
        repo = tags.get("repo", "").split("/")[-1]
        ref = (repo if repo != "discobox" else "") + (" " if repo != "discobox" and tags.get("issue") else "") + (tags.get("issue") or "")
        label = f"{ref or repo} {tags['job']}".strip()
        boxes.append({"id": b["id"], "label": label})
    mx = 6
    try:
        for line in open(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "manager.yaml")):
            if line.strip().startswith("max:"):
                mx = int(line.split(":")[1]); break
    except Exception:
        pass
    return {"max": mx, "boxes": boxes}


# --- ranking ------------------------------------------------------------------

def release_config():
    """manager.yaml's release: {repo, milestone, next, alsoIn}. Read by hand: no yaml module here."""
    cfg = {"repo": "discobox-ai/discobox", "milestone": "", "next": "", "alsoIn": []}
    try:
        lines = open(os.path.join(ROOT, "manager.yaml")).read().splitlines()
    except OSError:
        return cfg
    inside = also = False
    for line in lines:
        if re.match(r"^release:\s*$", line):
            inside = True
            continue
        if inside and line and not line.startswith(" ") and not line.startswith("#"):
            break
        if not inside:
            continue
        m = re.match(r"^  (repo|milestone|next):\s*(.*?)\s*$", line)
        if m:
            cfg[m.group(1)] = m.group(2).strip("'\"")
            also = False
            continue
        if re.match(r"^  alsoIn:\s*$", line):
            also = True
            continue
        m = re.match(r"^    - \s*(\S+)", line)
        if also and m:
            cfg["alsoIn"].append(m.group(1))
    return cfg


def focus_config():
    """manager.yaml's focus: [(stream, [owner/repo#n, ...]), ...], in the owner's order."""
    streams = []
    try:
        lines = open(os.path.join(ROOT, "manager.yaml")).read().splitlines()
    except OSError:
        return streams
    inside = False
    for line in lines:
        if re.match(r"^focus:\s*(#.*)?$", line):
            inside = True
            continue
        if inside and line and not line.startswith(" ") and not line.startswith("#"):
            break
        if not inside:
            continue
        m = re.match(r"^  - \s*stream:\s*(\S+)", line)
        if m:
            streams.append((m.group(1).strip("'\""), []))
            continue
        m = re.match(r"^      - \s*([\w.-]+/[\w.-]+#\d+)", line)
        if m and streams:
            streams[-1][1].append(m.group(1))
    return streams


def target(r, owner, default_repo):
    """The GitHub issue or PR a row is about, as (owner/repo, number), or None."""
    for field in ("issue", "pr"):
        v = str(r.get(field, "-"))
        m = re.match(r"^(?:([a-z][\w.-]*) )?(\d+)$", v)
        if m:
            return (f"{owner}/{m.group(1)}" if m.group(1) else default_repo, m.group(2))
    m = re.match(r"^(?:([a-z][\w.-]*) )?pr (\d+)$|^pr (?:([a-z][\w.-]*) )?(\d+)$", key_of(r))
    if m:
        name, num = (m.group(1), m.group(2)) if m.group(2) else (m.group(3), m.group(4))
        return (f"{owner}/{name}" if name else default_repo, num)
    return None


def fetch(repo, num):
    import subprocess
    out = subprocess.run(["gh", "api", f"repos/{repo}/issues/{num}", "--jq",
                          "{state, milestone: (.milestone.title // \"\"), labels: [.labels[].name]}"],
                         capture_output=True, text=True)
    if out.returncode != 0:
        return None
    return json.loads(out.stdout)


def classify(r, info, cfg, owner):
    names = {1: "Blocker", 2: cfg["milestone"] or "Release", 3: cfg["next"] or "Next", 4: "Other", 5: "Done"}
    labels = info.get("labels", []) if info else []
    prio = next((p for p in PRIOS if f"priority/{p}" in labels), "none")
    t = target(r, owner, cfg["repo"])
    ref = ""
    if t:
        repo, num = t
        ref = f"{repo}#{num}" if repo != cfg["repo"] else f"{cfg['repo']}#{num}"
    stream = r.get("stream") if r.get("stream") in {s for s, _ in focus_config()} else None
    if not stream and ref:
        stream = next((s for s, items in focus_config() if ref in items), None)
    if stream:
        r["stream"] = stream
    else:
        r.pop("stream", None)
    if info and info.get("state") == "closed":
        g = 5
    elif stream:
        return 0, prio, f"0 Focus: {stream} ({prio})"
    elif "type/flake" in labels or str(r.get("blocker", "")).lower() in ("yes", "true", "1"):
        g = 1
    elif info and cfg["milestone"] and info.get("milestone") == cfg["milestone"]:
        g = 2
    elif ref and ref in cfg["alsoIn"]:
        g = 2
    elif info and cfg["next"] and info.get("milestone") == cfg["next"]:
        g = 3
    else:
        g = 4
    return g, prio, f"{g} {names[g]} ({prio})"


def rank(rows, keys=None):
    from concurrent.futures import ThreadPoolExecutor
    cfg = release_config()
    owner = cfg["repo"].split("/")[0]
    todo = [r for r in rows if keys is None or key_of(r) in keys]
    with ThreadPoolExecutor(8) as ex:
        infos = list(ex.map(lambda r: (lambda t: fetch(*t) if t else None)(target(r, owner, cfg["repo"])), todo))
    for r, info in zip(todo, infos):
        if info is None and target(r, owner, cfg["repo"]):
            continue  # GitHub didn't answer: keep what the row had
        g, prio, why = classify(r, info, cfg, owner)
        r["group"], r["prio"], r["why"] = g, prio, why


# --- sync ---------------------------------------------------------------------
# A move names PRs as "PR 1102", "vm PR 112" or "discobox-ai/x PR 2"; a bare
# "PR N" is in the row's own repository.
PR_REF = re.compile(r"(?:(?:discobox-ai/)?([a-z][\w.-]*) )?PR (\d+)")


def pr_state(repo, num):
    import subprocess
    out = subprocess.run(["gh", "api", f"repos/{repo}/pulls/{num}", "--jq",
                          "if .merged_at then \"merged\" else .state end"], capture_output=True, text=True)
    return out.stdout.strip() if out.returncode == 0 else None


def sync(rows):
    """Clear moves that name only finished PRs; drop rows whose issue closed. Returns notes."""
    cfg = release_config()
    owner = cfg["repo"].split("/")[0]
    names = {r["name"].split("/")[-1] for r in repos_config()} or {"discobox"}
    notes, keep = [], []
    for r in rows:
        t = target(r, owner, cfg["repo"])
        own_repo = t[0] if t else cfg["repo"]
        move = str(r.get("yourMove", "–"))
        refs = []
        for m in PR_REF.finditer(move):
            name = m.group(1)
            repo = f"{owner}/{name}" if name and name in names | {"x", "ultraviolet"} else own_repo
            refs.append((repo, m.group(2)))
        # Only a move that asks for a merge: "Release X (PR 7 is merged)" is not one.
        asks_merge = re.search(r"\b(?:merge|merging)\b", move, re.I) and not re.search(r"\bis merged\b", move, re.I)
        if refs and asks_merge and move.strip() not in ("–", "-", ""):
            states = [pr_state(repo, n) for repo, n in refs]
            if all(s in ("merged", "closed") for s in states):
                done = ", ".join(f"{repo.split('/')[-1]} PR {n} {s}" for (repo, n), s in zip(refs, states))
                r["yourMove"] = "–"
                r["doing"] = f"{done}. " + str(r.get("doing", "")).split(" | was: ")[0][:200]
                notes.append(f"{key_of(r)}: move cleared ({done})")
        if t and r.get("group") == 5:
            open_pr = any(pr_state(repo, n) == "open" for repo, n in refs)
            if not open_pr:
                notes.append(f"{key_of(r)}: removed (issue closed)")
                continue
        keep.append(r)
    rows[:] = keep
    return notes


def repos_config():
    out, cur = [], None
    try:
        for line in open(os.path.join(ROOT, "manager.yaml")):
            m = re.match(r"^  - name:\s*(\S+)", line)
            if m:
                out.append({"name": m.group(1)})
    except OSError:
        pass
    return out


def sort_rows(rows):
    """Stable: by group, then priority; rows never ranked keep their place relative to their neighbours' group 4."""
    streams = [s for s, _ in focus_config()]
    def k(r):
        g = r.get("group", 4)
        g = g if isinstance(g, int) else 4
        p = r.get("prio", "none")
        pi = PRIOS.index(p) if p in PRIOS else len(PRIOS)
        if g == 1 and str(r.get("blocker", "")).lower() in ("yes", "true", "1"):
            # A row the owner fast-tracked (blocker=yes) tops the table, above
            # the focus streams; a flake stays a plain blocker below them.
            return (-1, 0, 0, pi)
        if g == 0:
            # Focus: by stream in the owner's order, the owner's moves first.
            s = r.get("stream")
            si = streams.index(s) if s in streams else len(streams)
            mine = 0 if str(r.get("yourMove", "–")).strip() not in ("", "–", "-") else 1
            return (0, si, mine, pi)
        return (g, 0, 0, pi)
    rows.sort(key=k)


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return
    cmd, args = argv[1], argv[2:]
    d = load()
    rows = d["rows"]
    if cmd == "show":
        for n, r in enumerate(rows, 1):
            print(f"{n:2} {key_of(r):14} | {r.get('yourMove','–'):24} | {r.get('doing','')[:50]} | {r.get('item','')[:50]}")
        return
    if cmd in ("set", "add"):
        key, (fields, pos) = args[0], parse(args[1:])
        i = find(rows, key)
        if i < 0:
            row = blank(key)
            row.update(fields)
            place(rows, row, pos)
            rank(rows, {key})
        else:
            rows[i].update(fields)
            rows[i].setdefault("key", key)
            if pos:
                place(rows, rows.pop(i), pos)
            if "blocker" in fields or "issue" in fields or "pr" in fields or "stream" in fields:
                rank(rows, {key})
    elif cmd == "rm":
        d["rows"] = [r for r in rows if key_of(r) not in set(args)]
    elif cmd == "move":
        key, (_, pos) = args[0], parse(args[1:])
        i = find(rows, key)
        if i < 0:
            sys.exit(f"table: no row {key!r}")
        place(rows, rows.pop(i), pos)
    elif cmd == "link":
        label, url = args[0], args[1]
        d["links"] = [l for l in d["links"] if not l.startswith(label + ":")] + [f"{label}: {url}"]
    elif cmd == "slots":
        d["slots"] = slots()
    elif cmd == "rank":
        rank(rows, set(args) or None)
    elif cmd == "sync":
        rank(rows)
        for note in sync(rows):
            print(note)
    elif cmd == "unlink":
        d["links"] = [l for l in d["links"] if not any(l.startswith(a + ":") for a in args)]
    else:
        sys.exit(f"table: unknown command {cmd!r}")
    # Every write refreshes the slots line from the boxes' power state, so the
    # pane's "N/max running" never shows a box that has since paused or stopped
    # (owner, 2026-11-12). Best effort: a failed `discobox ls` keeps the old one.
    if cmd != "slots":
        try:
            d["slots"] = slots()
        except Exception:
            pass
    sort_rows(d["rows"])
    save(d)


if __name__ == "__main__":
    main(sys.argv)
