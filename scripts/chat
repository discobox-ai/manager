#!/usr/bin/env python3
"""The owner's chat with the manager, from the manager site (site/) and the status artifact.

  chat list [--json]       the owner's messages with no reply yet, oldest first
  chat show [N]            the last N messages of the thread (default 20), both sides
  chat reply ID TEXT ...   answer the owner's message ID; the reply shows in the thread

The owner's messages are chat.jsonl (the site-chat monitor watches it); replies go to
chat-replies.jsonl, so a reply never wakes the manager. Both are JSON lines in SITE_STATE_DIR
(default ~/.local/state/discobox-manager): {id, at, from, text[, replyTo]}.
"""
import datetime, json, os, secrets, sys, time

DIR = os.path.expanduser(os.environ.get("SITE_STATE_DIR", "~/.local/state/discobox-manager"))
OWNER = os.path.join(DIR, "chat.jsonl")
REPLIES = os.path.join(DIR, "chat-replies.jsonl")


def read(path):
    out = []
    try:
        with open(path) as f:
            for line in f:
                line = line.strip()
                if line:
                    try:
                        out.append(json.loads(line))
                    except ValueError:
                        pass
    except FileNotFoundError:
        pass
    return out


def thread():
    msgs = [dict(m, **{"from": "owner"}) for m in read(OWNER)] + [dict(m, **{"from": "manager"}) for m in read(REPLIES)]
    return sorted(msgs, key=lambda m: (m.get("at", ""), m.get("id", "")))


def unanswered():
    answered = {r.get("replyTo") for r in read(REPLIES)}
    return [m for m in read(OWNER) if m.get("id") not in answered]


def line(m):
    who = "owner  " if m["from"] == "owner" else "manager"
    text = m.get("text", "").replace("\n", "\n" + " " * 34)
    return f"{m.get('at', '')[:19]}Z {who} {m.get('id', ''):<14} {text}"


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__)
        return 0
    cmd, args = argv[1], argv[2:]
    if cmd == "list":
        msgs = unanswered()
        if "--json" in args:
            print(json.dumps(msgs, indent=2))
        elif not msgs:
            print("No unanswered messages.")
        for m in msgs if "--json" not in args else []:
            print(line(dict(m, **{"from": "owner"})))
        return 0
    if cmd == "show":
        n = int(args[0]) if args else 20
        for m in thread()[-n:]:
            print(line(m))
        return 0
    if cmd == "reply":
        if len(args) < 2:
            print("usage: chat reply ID TEXT ...", file=sys.stderr)
            return 2
        mid, text = args[0], " ".join(args[1:]).strip()
        if mid not in {m.get("id") for m in read(OWNER)}:
            print(f"no owner message {mid!r}; see `chat list`", file=sys.stderr)
            return 1
        reply = {
            "id": f"{int(time.time() * 1000):x}-{secrets.token_hex(3)}",
            "at": datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds").replace("+00:00", "Z"),
            "from": "manager",
            "text": text,
            "replyTo": mid,
        }
        os.makedirs(DIR, exist_ok=True)
        with open(REPLIES, "a") as f:
            f.write(json.dumps(reply) + "\n")
        print(f"replied to {mid}: {reply['id']}")
        return 0
    print(f"unknown command {cmd!r}\n{__doc__}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
