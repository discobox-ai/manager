#!/usr/bin/env bash
# List boxes of ours whose PR has merged or closed, or whose issue is closed
# (a finished worker the manager forgot to retire). Prints
# "<box> <state> <repo> #<issue>=<state> pr<N>=<state> <job>". With --retire,
# archives each one (`discobox rm`). Skips the merge gate, merge queue, pr-check and ad-hoc boxes.
set -euo pipefail
cd "$(dirname "$0")/.."
eval "$(discobox-access env)"
retire=0; [ "${1:-}" = --retire ] && retire=1
discobox ls -o json | jq -r '.sandboxes[]
  | select(.meta.tags.repo != null and .meta.tags.manager == null)
  | select((.meta.tags.job // "") | IN("merge-gate","merge-queue","pr-check","norm","adhoc") | not)
  | select((.runtime.runtimeState // "") != "" and .runtime.runtimeState != "archived")
  | [.id, (.runtime.runtimeState // ""), .meta.tags.repo, (.meta.tags.issue // ""), (.meta.tags.pr // ""), (.meta.tags.job // "")] | @tsv' |
while IFS=$'\t' read -r id st repo iss pr job; do
  ps=""; is=""
  [ -n "$pr" ] && ps=$(gh api "repos/$repo/pulls/$pr" --jq '.state + (if .merged then "/merged" else "" end)' 2>/dev/null || true)
  [ -n "$iss" ] && is=$(gh api "repos/$repo/issues/$iss" --jq .state 2>/dev/null || true)
  # Finished: its PR is closed (merged or not), or it has no PR and its issue is closed.
  done=0
  case "$ps" in closed*) done=1 ;; esac
  [ -z "$pr" ] && [ "$is" = closed ] && done=1
  [ $done = 1 ] || continue
  printf '%s %s %s #%s=%s pr%s=%s %s\n' "$id" "$st" "$repo" "$iss" "$is" "$pr" "$ps" "$job"
  [ $retire = 1 ] && discobox rm "$id" >/dev/null 2>&1 || true
done
